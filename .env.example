# ============================================================
# Chilean Fantasy — Plantilla de variables de entorno
# Copia este archivo a `.env` y rellena con tus valores reales.
# NUNCA subas el archivo .env a git.
# ============================================================

# --- Base de datos (Supabase PostgreSQL) ---
DB_HOST=db.<proyecto>.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASS=tu_password_real
DB_PORT=5432

# --- API de datos del fútbol chileno (RapidAPI SportAPI7) ---
RAPIDAPI_KEY=tu_api_key_rapidapi
RAPIDAPI_HOST=sportapi7.p.rapidapi.com

# --- Seguridad JWT ---
# Mínimo 16 caracteres; recomendado 32 o más (RFC 7518).
SECRET_KEY=reemplaza_por_una_clave_larga_de_32_mas_caracteres